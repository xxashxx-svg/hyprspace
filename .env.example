# Copy to .env to enable account sign-in. Both are optional — leave them unset and the app
# skips the sign-in gate entirely, which is what you want for local development.
#
# The anon key is the PUBLIC (publishable) key from your Supabase project's API settings.
# Never put the service_role key here — it ships to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anonymous product analytics (PostHog). Optional — leave unset and nothing is ever sent.
# Also inert in dev builds, so your own testing never pollutes the numbers.
# The project API key is the PUBLIC one; it is designed to ship in clients.
# See src/lib/analytics.ts for exactly what is (and isn't) collected.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
